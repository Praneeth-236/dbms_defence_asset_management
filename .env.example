DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=defence_asset_system
DB_USER=defence_app
DB_PASSWORD=replace_with_local_secret
AUTH_SESSION_SECRET=replace_with_a_long_random_secret
DB_SSL=false
# Optional PEM CA file path when connecting to a database with a private CA.
# DB_SSL_CA=/path/to/mysql-ca.pem

# Optional local-development endpoint. In production set REDIS_URL to the
# private managed Redis service; loopback Redis URLs are intentionally rejected.
# If Redis is omitted or unavailable, the app continues with MySQL.
REDIS_URL=redis://127.0.0.1:6379
